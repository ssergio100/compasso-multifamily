# Copie para .env durante uma instalação manual. O instalador faz isso sozinho.
COMPASSO_VERSION=0.1.0-dev
COMPASSO_API_BIND_ADDRESS=0.0.0.0
COMPASSO_API_PORT=8181
COMPASSO_DATA_DIRECTORY=/srv/docker/volumes/compasso
COMPASSO_BACKUP_DIRECTORY=/srv/docker/backups/compasso
# No piloto público, use a origem HTTPS exata do painel. Ela também será usada
# nos links enviados por e-mail.
COMPASSO_ADMIN_ORIGIN=same-host
COMPASSO_SECURE_COOKIES=false
COMPASSO_HEARTBEAT_INTERVAL=3s
# SMTP com STARTTLS obrigatório. Deixe todos vazios enquanto o cadastro
# autônomo não estiver publicado.
COMPASSO_SMTP_ADDRESS=
COMPASSO_SMTP_USERNAME=
COMPASSO_SMTP_PASSWORD=
COMPASSO_SMTP_FROM=
# Ative somente depois de atualizar os agentes existentes.
COMPASSO_REQUIRE_INSTALLATION_IDENTITY=false
