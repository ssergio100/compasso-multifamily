<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CompassoInstaller.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CompassoInstaller"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BrandColumn.Width" Value="0" />
                        <Setter Target="BrandPanel.Visibility" Value="Collapsed" />
                        <Setter Target="ContentPanel.(Grid.Column)" Value="0" />
                        <Setter Target="ContentPanel.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BrandColumn.Width" Value="360" />
                        <Setter Target="BrandPanel.Visibility" Value="Visible" />
                        <Setter Target="ContentPanel.(Grid.Column)" Value="1" />
                        <Setter Target="ContentPanel.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BrandColumn" Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="BrandPanel"
            Background="{ThemeResource CompassoBrandPanelBrush}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="24">
                <Grid
                    Width="154"
                    Height="116"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Marca Compasso">
                    <Rectangle
                        Width="22"
                        Height="50"
                        Margin="12,44,0,18"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        RadiusX="10"
                        RadiusY="10" />
                    <Rectangle
                        Width="22"
                        Height="72"
                        Margin="42,22,0,18"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        RadiusX="10"
                        RadiusY="10" />
                    <Rectangle
                        Width="22"
                        Height="92"
                        Margin="66,2,0,18"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        RadiusX="10"
                        RadiusY="10" />
                    <Rectangle
                        Width="22"
                        Height="72"
                        Margin="96,22,0,18"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        RadiusX="10"
                        RadiusY="10" />
                    <Rectangle
                        Width="22"
                        Height="50"
                        Margin="126,44,6,18"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        RadiusX="10"
                        RadiusY="10" />
                    <Rectangle
                        Height="6"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        RadiusX="3"
                        RadiusY="3" />
                </Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="38"
                    FontWeight="SemiBold"
                    Text="Compasso" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            x:Name="ContentPanel"
            Grid.Column="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Padding="56,42,56,32">
                <StackPanel
                    MaxWidth="760"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="20">
                    <StackPanel Spacing="10">
                        <TextBlock
                            x:Name="PageTitle"
                            FontSize="46"
                            FontWeight="SemiBold"
                            Text="Instalar o Compasso"
                            TextWrapping="Wrap" />
                        <TextBlock
                            MaxWidth="700"
                            HorizontalAlignment="Left"
                            FontSize="21"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Este computador poderá seguir os limites e as rotinas definidos pela sua família."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,8,0,4" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon
                                FontSize="24"
                                Foreground="{ThemeResource CompassoSuccessBrush}"
                                Glyph="&#xE73E;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="19"
                                Text="Controle de tempo mesmo sem internet"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon
                                FontSize="24"
                                Foreground="{ThemeResource CompassoSuccessBrush}"
                                Glyph="&#xE73E;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="19"
                                Text="Avisos antes do bloqueio"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon
                                FontSize="24"
                                Foreground="{ThemeResource CompassoSuccessBrush}"
                                Glyph="&#xE73E;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="19"
                                Text="Aplicativo para adicionar tempo e configurar"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle
                        Height="1"
                        Margin="0,8"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock
                        FontSize="17"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Será instalado para todas as contas deste computador."
                        TextWrapping="Wrap" />

                    <CheckBox
                        x:Name="DesktopShortcutCheckBox"
                        AutomationProperties.Name="Criar atalho na área de trabalho"
                        Content="Criar atalho na área de trabalho"
                        FontSize="17"
                        HorizontalAlignment="Left" />

                    <StackPanel Spacing="10">
                        <ProgressBar
                            x:Name="ElevationProgress"
                            AutomationProperties.Name="Verificando permissão de administrador"
                            IsIndeterminate="True"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="ProgressText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Aguardando a confirmação do Windows…"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <InfoBar
                            x:Name="StatusInfoBar"
                            AutomationProperties.LiveSetting="Polite"
                            IsClosable="False"
                            IsOpen="False" />
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <Button
                            x:Name="InstallButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.HelpText="Instala o aplicativo do Compasso neste computador"
                            Click="InstallButton_Click"
                            Content="Instalar"
                            Style="{StaticResource CompassoPrimaryButtonStyle}" />
                        <Button
                            x:Name="UninstallButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.HelpText="Remove o aplicativo do Compasso deste computador"
                            Click="UninstallButton_Click"
                            Content="Desinstalar"
                            FontSize="17"
                            MinHeight="52"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="CancelButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Fechar instalador"
                            Click="CancelButton_Click"
                            Content="Fechar"
                            FontSize="17"
                            MinHeight="52" />
                    </StackPanel>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            FontSize="22"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xEA18;" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Ao continuar, o Windows solicitará permissão de administrador."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Versão 0.1" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
