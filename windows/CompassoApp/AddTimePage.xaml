<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CompassoApp.AddTimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CompassoApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource CompassoPageBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Padding="28,40,28,28">
                <!--
                    Stretch, e nao Center: com Center o painel encolhe ate o
                    conteudo e o MaxWidth nunca vale, deixando a coluna estreita
                    e a janela com sobra vazia nas laterais.
                -->
                <StackPanel MaxWidth="448" HorizontalAlignment="Stretch" Spacing="22">

                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource CompassoPageTitleStyle}" Text="Adicionar tempo" />
                        <TextBlock
                            Style="{StaticResource CompassoSubtitleStyle}"
                            Text="Escolha o período e confirme com a senha do responsável." />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="10" Height="10" Fill="{ThemeResource CompassoMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="ConnectionStatusText"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CompassoMutedBrush}"
                                Text="Verificando serviço…" />
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton
                                x:Name="Duration15"
                                AutomationProperties.Name="15 minutos"
                                Click="Duration_Click"
                                Content="15 min"
                                GroupName="DurationOptions"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="48"
                                Style="{StaticResource CompassoDurationButtonStyle}"
                                Tag="15" />
                            <RadioButton
                                x:Name="Duration30"
                                AutomationProperties.Name="30 minutos"
                                Click="Duration_Click"
                                Content="30 min"
                                GroupName="DurationOptions"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="48"
                                Style="{StaticResource CompassoDurationButtonStyle}"
                                Tag="30" />
                            <RadioButton
                                x:Name="Duration60"
                                AutomationProperties.Name="60 minutos"
                                Click="Duration_Click"
                                Content="60 min"
                                GroupName="DurationOptions"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="48"
                                Style="{StaticResource CompassoDurationButtonStyle}"
                                Tag="60" />
                            <RadioButton
                                x:Name="Duration120"
                                AutomationProperties.Name="120 minutos"
                                Click="Duration_Click"
                                Content="120 min"
                                GroupName="DurationOptions"
                                Grid.Column="3"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="48"
                                Style="{StaticResource CompassoDurationButtonStyle}"
                                Tag="120" />
                    </Grid>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource CompassoFieldLabelStyle}" Text="Senha do responsável" />
                        <Border
                            MinHeight="52"
                            Style="{StaticResource CompassoFieldBorderStyle}">
                            <Grid>
                                <PasswordBox
                                    x:Name="PasswordBox"
                                    AutomationProperties.HelpText="A senha não será armazenada neste computador"
                                    AutomationProperties.Name="Senha do responsável"
                                    IsPasswordRevealButtonEnabled="False"
                                    MinHeight="52"
                                    Padding="12,8,48,8"
                                    PasswordRevealMode="Hidden"
                                    PlaceholderText="Digite sua senha"
                                    Style="{StaticResource CompassoPasswordFieldBoxStyle}" />
                                <Button
                                    x:Name="RevealPasswordButton"
                                    AutomationProperties.Name="Mostrar a senha"
                                    Click="RevealPasswordButton_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Right"
                                    MinWidth="48"
                                    MinHeight="52"
                                    Padding="10,0"
                                    VerticalAlignment="Center">
                                    <SymbolIcon Symbol="View" Foreground="{ThemeResource CompassoMutedBrush}" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Button
                        x:Name="AddTimeButton"
                        Click="AddTimeButton_Click"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource CompassoPrimaryButtonStyle}" />

                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource CompassoMutedBrush}"
                            Glyph="&#xE946;"
                            VerticalAlignment="Center" />
                        <TextBlock
                            FontStyle="Italic"
                            Foreground="{ThemeResource CompassoMutedBrush}"
                            Text="A senha não será armazenada."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <InfoBar
                        x:Name="StatusInfoBar"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="False"
                        IsOpen="False" />

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--
            Rodape com a entrada para Configuracoes, com icone de engrenagem. Fora
            do ScrollViewer para nao subir nem descer com a rolagem do conteudo.
        -->
        <Grid Grid.Row="1" Margin="24,0,24,20">
            <StackPanel MaxWidth="448" HorizontalAlignment="Stretch">
                <Rectangle
                    Height="1"
                    Fill="{ThemeResource CompassoLineBrush}" />
                <Button
                    x:Name="OpenSettingsButton"
                    AutomationProperties.Name="Abrir configurações do Compasso"
                    Click="OpenSettingsButton_Click"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    MinHeight="40"
                    Style="{StaticResource CompassoFooterButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource CompassoInkBrush}"
                            Glyph="&#xE713;" />
                        <TextBlock
                            Foreground="{ThemeResource CompassoInkBrush}"
                            Text="Configurações" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
