<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="CompassoApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CompassoApp">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Cores extraidas dos conceitos de Adicionar tempo e Configuracoes. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CompassoBrandBrush" Color="#DD6D50" />
                    <SolidColorBrush x:Key="CompassoBrandHoverBrush" Color="#C75F45" />
                    <SolidColorBrush x:Key="CompassoBrandForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CompassoBrandPressedBrush" Color="#B8553D" />
                    <SolidColorBrush x:Key="CompassoBrandDisabledBrush" Color="#E5B7A8" />
                    <SolidColorBrush x:Key="CompassoSuccessBrush" Color="#819484" />
                    <SolidColorBrush x:Key="CompassoPageBrush" Color="#F5F5F3" />
                    <SolidColorBrush x:Key="CompassoSettingsPageBrush" Color="#F3F4F1" />
                    <SolidColorBrush x:Key="CompassoFieldBrush" Color="#F5F4F2" />
                    <SolidColorBrush x:Key="CompassoChipBrush" Color="#D9DCD8" />
                    <SolidColorBrush x:Key="CompassoInkBrush" Color="#261D2B" />
                    <SolidColorBrush x:Key="CompassoMutedBrush" Color="#716B73" />
                    <SolidColorBrush x:Key="CompassoLineBrush" Color="#D8D5D7" />
                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#819484" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CompassoBrandBrush" Color="#EE765C" />
                    <SolidColorBrush x:Key="CompassoBrandHoverBrush" Color="#D96A52" />
                    <SolidColorBrush x:Key="CompassoBrandForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CompassoBrandPressedBrush" Color="#C0593F" />
                    <SolidColorBrush x:Key="CompassoBrandDisabledBrush" Color="#6B4A41" />
                    <SolidColorBrush x:Key="CompassoSuccessBrush" Color="#91AD9F" />
                    <SolidColorBrush x:Key="CompassoPageBrush" Color="#20201E" />
                    <SolidColorBrush x:Key="CompassoSettingsPageBrush" Color="#20201E" />
                    <SolidColorBrush x:Key="CompassoFieldBrush" Color="#2A2A28" />
                    <SolidColorBrush x:Key="CompassoChipBrush" Color="#3A3C39" />
                    <SolidColorBrush x:Key="CompassoInkBrush" Color="#F2F2F0" />
                    <SolidColorBrush x:Key="CompassoMutedBrush" Color="#B6B3B0" />
                    <SolidColorBrush x:Key="CompassoLineBrush" Color="#43423F" />
                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#91AD9F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CompassoBrandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CompassoBrandHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CompassoBrandForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="CompassoBrandPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CompassoBrandDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="CompassoSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CompassoPageBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CompassoSettingsPageBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CompassoFieldBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CompassoChipBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CompassoInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CompassoMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CompassoLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                AccentButtonStyle traz o hover azul do sistema, que nao pertence a
                identidade do Compasso. O Button do WinUI 3 nao expoe
                BackgroundPressed nem BackgroundDisabled como propriedades
                definiveis em estilo: o template anima o fundo por
                ObjectAnimationUsingKeyFrames lendo recursos AccentButton*. Por
                isso o template e reescrito aqui, e cada estado aponta para os
                pincis da marca em vez dos do sistema.
            -->
            <Style
                x:Key="CompassoPrimaryButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource CompassoBrandBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CompassoBrandBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource CompassoBrandForegroundBrush}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="60" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="28,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                AutomationProperties.AccessibilityView="Raw"
                                Background="{TemplateBinding Background}"
                                BackgroundSizing="OuterBorderEdge"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Foreground="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.083" />
                                </ContentPresenter.BackgroundTransition>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ContentPresenter"
                                                    Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CompassoBrandHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ContentPresenter"
                                                    Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CompassoBrandHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ContentPresenter"
                                                    Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CompassoBrandPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ContentPresenter"
                                                    Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CompassoBrandPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ContentPresenter"
                                                    Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CompassoBrandDisabledBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ContentPresenter"
                                                    Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CompassoBrandDisabledBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botao de link usado em "Configuracoes" e "Voltar para adicionar tempo". -->
            <Style x:Key="CompassoLinkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource CompassoBrandBrush}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!-- Rotulo de secao, medido em 30px de altura nos dois conceitos. -->
            <Style x:Key="CompassoSectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource CompassoInkBrush}" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <Style x:Key="CompassoFieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource CompassoInkBrush}" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <!-- O contorno pertence ao Border externo. O controle de edição
                 interno fica sem o chrome Fluent que enfatiza a base. -->
            <Style x:Key="CompassoFieldBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CompassoFieldBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CompassoLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="CompassoFieldBoxStyle" TargetType="TextBox">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="CompassoPasswordFieldBoxStyle" TargetType="PasswordBox">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- Botao do rodape: icone de engrenagem mais "Configuracoes". -->
            <Style x:Key="CompassoFooterButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,0" />
            </Style>

            <!-- Grupo de escolha exclusiva dos tempos. RadioButton garante que
                 escolher um período desmarque o anterior; o template mantém a
                 aparência do conceito sem exibir o marcador circular padrão. -->
            <Style
                x:Key="CompassoDurationButtonStyle"
                TargetType="RadioButton">
                <Setter Property="Background" Value="{ThemeResource CompassoFieldBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CompassoLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource CompassoInkBrush}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <!-- O RadioButton nativo pede uma largura mínima maior que a
                     coluna de 1/4 desta tela e seria recortado à direita. -->
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="Root">
                                <Border
                                    x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                    <ContentPresenter
                                        x:Name="ButtonContent"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Padding="{TemplateBinding Padding}" />
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Root"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.88"
                                                    Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Root"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.45"
                                                    Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CompassoFieldBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CompassoLineBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonContent" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CompassoInkBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CompassoBrandBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CompassoBrandBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonContent" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CompassoBrandForegroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CompassoPageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="46" />
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="CharacterSpacing" Value="-25" />
                <Setter Property="Foreground" Value="{ThemeResource CompassoInkBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CompassoSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{ThemeResource CompassoMutedBrush}" />
                <Setter Property="CharacterSpacing" Value="-8" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
